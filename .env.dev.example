# === Suitest Dev Environment (Isolated Local Mode Example) ===
# Copy to .env or .env.local to run development without colliding with release binaries or Docker.
SUITEST_MODE=local
SUITEST_DATA_DIR=.suitest-dev
SUITEST_DATABASE_URL=sqlite+aiosqlite:///.suitest-dev/suitest.db
SUITEST_ARTIFACTS_BACKEND=local
SUITEST_ARTIFACTS_DIR=.suitest-dev/artifacts

# Encryption & Auth Keys (replace with your random keys)
SUITEST_ENCRYPTION_KEY=ZFutt/voX2Rccfbl5u/d5j20fuCUkFipo/ddg08ozS8=
SUITEST_AUTH_SECRET=zE1k+zTsl19UseisbxvvQ480geQxlu/w7K0wPWshO4Q=

# Dev Ports & URLs (Dev backend port 8000, Dev frontend port 5173)
# Release uses API 4000/4040, Web 3000/3033.
SUITEST_API_PORT=8000
SUITEST_API_URL=http://localhost:8000
SUITEST_WEB_URL=http://localhost:5173
VITE_PORT=5173
VITE_BACKEND_PORT=8000

# Redis Isolation (6380, leaves 6379 for release; in local mode Redis is not required)
SUITEST_REDIS_PORT=6380
SUITEST_REDIS_URL=redis://localhost:6380/0

# Otel
SUITEST_OTEL_DISABLED=1

# Test Execution Password Resolution for {{password}} placeholders
SUITEST_PASSWORD=secret_sauce
TEST_PASSWORD=secret_sauce

