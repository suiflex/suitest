{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "always-update": true,
  "include-component-in-tag": true,
  "packages": {
    "packages/mcp-npx": {
      "release-type": "node",
      "component": "mcp",
      "package-name": "@suiflex/suitest-mcp",
      "extra-files": ["VERSION"]
    },
    "packages/lifecycle": {
      "release-type": "python",
      "component": "lifecycle",
      "package-name": "suiflex-suitest-lifecycle",
      "extra-files": [
        {
          "type": "generic",
          "path": "src/suitest_lifecycle/__init__.py"
        }
      ]
    },
    "sdk/typescript": {
      "release-type": "node",
      "component": "tssdk",
      "package-name": "@suiflex/suitest-sdk"
    },
    "sdk/python": {
      "release-type": "python",
      "component": "pysdk",
      "package-name": "suiflex-suitest-sdk",
      "extra-files": [
        {
          "type": "generic",
          "path": "src/suitest_sdk/__init__.py"
        }
      ]
    },
    "cli": {
      "release-type": "python",
      "component": "cli",
      "package-name": "suiflex-suitest-cli",
      "extra-files": [
        {
          "type": "generic",
          "path": "src/suitest_cli/__init__.py"
        }
      ]
    },
    ".": {
      "release-type": "simple",
      "component": "launcher",
      "package-name": "@suiflex/suitest",
      "changelog-path": "packages/suitest-npx/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/suitest-npx/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": ["packages/mcp-npx", "packages/lifecycle", "sdk/typescript"]
    }
  }
}
